# Existing Google Sheet created for your tracker
GOOGLE_SHEET_ID=1pN3Y1090EVvfTal_-1N1bU-h-3TCWQ2POt-vYdcOmCs
GOOGLE_SHEET_VACANCIES_TAB=Vacancies
GOOGLE_SHEET_PROFILE_TAB=Profile

# oauth = interactive sign-in once. Recommended for personal Google account.
# service_account = unattended server account; share the Sheet with its client_email.
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Safety: never turn submission on by accident.
SEND_APPLICATIONS_ENABLED=false

# --- v0.8 skill-based discovery -------------------------------------------
# Sources to query. Leave UNSET to use every free source:
#   ba, arbeitnow, greenhouse, lever, ashby, career_page
# An ATS source skips itself when data/employers.json lists no board for it,
# so the default costs nothing. `brave` needs a paid-tier API key and is never
# enabled by default -- add it here explicitly if you ever want it.
# JOB_SOURCES=ba,arbeitnow,greenhouse,ashby
# The employer registry. Boards live here with their verification date; the two
# variables below are for trying a board without editing the registry.
EMPLOYERS_FILE=data/employers.json
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
# Pages of the Arbeitnow feed to scan per run (1-5).
ARBEITNOW_PAGES=3
# Leave empty for all career tracks; see `job-agent tracks`.
CAREER_TRACKS=
# Accept remote-Germany postings. Default true: measured read-only on
# 2026-11-21, the verified ATS boards published 0 postings in the three cities
# but 34 including remote-Germany, so turning this off silences them entirely.
ALLOW_REMOTE_GERMANY=true
# Local cache of adverts and assessments. Never commit it.
DESCRIPTION_CACHE_FILE=data/description_cache.json

# --- per-source fairness --------------------------------------------------
# Max fraction of the daily candidate budget (--max-new) any one source may
# contribute. Round-robin alone is not fairness: once the small sources run
# dry the largest feed takes every remaining slot (measured: BA 28, Arbeitnow
# 1, Ashby 1 out of 30). Ignored when only one source has candidates.
SOURCE_DEFAULT_SHARE=0.5
# Per-source overrides, e.g. ba:0.4,ashby:0.3 . A share of 0 still leaves one
# slot: a cap must never silence a source outright.
SOURCE_SHARES=
# true hands capped-away slots back out, filling --max-new at the cost of the cap.
SOURCE_FILL_LEFTOVER=false

# --- status bands ---------------------------------------------------------
# Review stays at the Sheets Profile "Min match score" (80). Scores from here
# up to that threshold are saved as "Potential" instead of "Skip". A stated
# eligibility conflict forces "Skip" whatever the score.
POTENTIAL_MIN_SCORE=65

# Runs an unreadable advert is retried before it is closed as "Unreadable".
# Set with --max-detail-attempts on a single run.
# MAX_DETAIL_ATTEMPTS=3

# --- Brave Search discovery (optional, metered) ---------------------------
# Free tier: 1 request/second, 2000 queries/month, no card required.
# Get a key at https://brave.com/search/api/ . Leave empty to disable.
# Cost control: one run uses at most BRAVE_MAX_QUERIES search calls.
# At the default 8 queries, one run per day is ~240 queries/month.
BRAVE_SEARCH_API_KEY=
BRAVE_MAX_QUERIES=8
BRAVE_RESULTS_PER_QUERY=10
# Employer pages fetched per run to verify a lead is a real, current vacancy.
BRAVE_MAX_VERIFICATIONS=12
# Keep false: aggregator copies are ranked out so the employer's own posting wins.
BRAVE_ALLOW_AGGREGATORS=false

# --- LLM provider ---------------------------------------------------------
# gemini = remote API, costs tokens, and the default. ollama = local, free.
# See `job-agent providers`. Adding Anthropic/OpenAI needs no discovery changes.
MATCH_LLM_PROVIDER=gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
